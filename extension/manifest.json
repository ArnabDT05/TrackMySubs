{
  "manifest_version": 3,
  "name": "TrackMySubs Ext",
  "version": "1.0.0",
  "description": "Quickly add subscriptions while browsing.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
